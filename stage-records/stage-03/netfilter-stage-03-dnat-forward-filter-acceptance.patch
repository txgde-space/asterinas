 /// Emits an explicit boot-time marker for the Stage 2 forwarding pipeline.
 pub fn init() {
@@ -50,6 +57,36 @@ pub fn init() {
             println!("netfilter-stage3: ICMP MASQUERADE acceptance rule installed");
